package com.objectclass;

public class EqualsMethod 
{
	int i;
	String j;

	public EqualsMethod(int i,String j) {
	
		i=this.i;
		j=this.j;
	}

	@Override
	public int hashCode() {
		final int prime = 31;
		int result = 1;
		result = prime * result + i;
		result = prime * result + ((j == null) ? 0 : j.hashCode());
		return result;
	}
	
	@Override
	public boolean equals(Object obj) {
		if (this == obj)
			return true;
		if (obj == null)
			return false;
		if (getClass() != obj.getClass())
			return false;
		EqualsMethod other = (EqualsMethod) obj;
		if (i != other.i)
			return false;
		if (j == null) {
			if (other.j != null)
				return false;
		} else if (!j.equals(other.j))
			return false;
		return true;
	}
	public static void main(String []args)
	{   
		EqualsMethod h=new EqualsMethod(1,"abc");
		EqualsMethod h1=new EqualsMethod(1,"acbc");
		int k=h.hashCode();
		int k1=h1.hashCode();
		   boolean b=h.equals(h1);
		System.out.println("Hashcode of h:"+k);
		System.out.println("Hashcode of h1:"+k1);
		System.out.println(b);
	}
}
