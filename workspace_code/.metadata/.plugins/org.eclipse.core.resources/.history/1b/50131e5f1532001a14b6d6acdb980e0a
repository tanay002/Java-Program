package com.bytecoder.objectclassmethod;

class Coaching 
{
int Id;
String Name;
String Batch;
int Rollno;

public Coaching(int Id,String Name,String Batch,int Rollno)
{
this.Id=Id;
this.Name=Name;
this.Batch=Batch;
this.Rollno=Rollno;
}
public int hashCode()
{
int q=(Id+" "+Name+Batch+Rollno).hashCode();
return q;
}
public boolean equals(Object o)
{
	Coaching c2=(Coaching)o;
if(this.hashCode()==c2.hashCode())	
{
return true;
}
else
{
return false; 	
}
}
}

public class HashCodeCoaching1 
{
public static void main(String[] args) 
{
Coaching c1=new Coaching(23,"Rahul","PCM",45);	
		Coaching c2=new Coaching(23,"Rahul","PCM",45);
		System.out.println(c1);
		System.out.println(c2);
int m=c1.hashCode();
int k=c2.hashCode();
System.out.println(m);
System.out.println(k);
}
}
