package com.bytecoder.objectclassmethod;

class Data
{
int id;
String name;
String stream;

Data(int id,String name,String stream )
{
this.id=id;
this.name=name;
this.stream=stream;
}

public int hashCode()
{
int h =(id+name+stream).hashCode();	
return h;
}

}



public class HashCodeData {
public static void main(String[] args) {
	Data d1=new Data(32,"Tanay","MCA");
	Data d2=new Data(32,"Tanay","MCA");
	int l=d1.hashCode();
	int m=d2.hashCode();
	System.out.println(l);
	System.out.println(m);
}
}
