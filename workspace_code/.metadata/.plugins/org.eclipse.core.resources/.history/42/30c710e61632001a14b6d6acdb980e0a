package com.objectclass;

public class EqualsMethod 
{
	int i;
	String j;

	public EqualsMethod(int i,String j) {
	
		i=this.i;
		j=this.j;
	}
	public String toString()
	{
		return i+" "+j;	
	}
	public int hashCode()
	{
		int g= (i+" "+j).hashCode();
		return g;
	}
	
	public boolean equals(Object obj)
	{
		EqualsMethod e=(EqualsMethod)obj;
		if(this.hashCode()==e.hashCode())
			return true;
		else
			return false;
	}
	public static void main(String []args)
	{   
		EqualsMethod h=new EqualsMethod(1,"abbc");
		EqualsMethod h1=new EqualsMethod(1,"abc");
		/*int k=h.hashCode();
		int k1=h1.hashCode();
		System.out.println("Hashcode of h:"+k);
		System.out.println("Hashcode of h1:"+k1);*/
		 boolean b=h.equals(h1); 
		 System.out.println(b);
	}
}
