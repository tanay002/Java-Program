package com.objectclass;

//HashCode overrided
public class HashCode2_overrided
{
	int i;
	String j;

	public HashCode2_overrided(int i,String j)
	{
		i=this.i;
		j=this.j;
	}

	public int hashCode()
	{
		int g= (i+" "+j).hashCode();
		return g;
	}
	public static void main(String []args)
	{
		HashCode2_overrided h=new HashCode2_overrided(1,"abc");
		HashCode2_overrided h1=new HashCode2_overrided(1,"anbc");
		int k=h.hashCode();
		int k1=h1.hashCode();
		System.out.println(k==k1);
		System.out.println(k1);
	}

}