package com.bytecoder.objectclassmethod;

class College
{
	int StudentId;
	int EnrollNo;
	String StudentName;
	String Stream;
	int TeacherId;
 
	College(int StudentId,int EnrollNo,String StudentName,String Stream,int TeacherId )
	{
	 this.StudentId=StudentId;
	 this.EnrollNo=EnrollNo;
	 this.StudentName=StudentName;
	 this.Stream=Stream;
	 this.TeacherId=TeacherId;
	}

public String toString()
	{
	String h=StudentId+" "+EnrollNo+" "+StudentName+" "+Stream+" "+TeacherId;return h;
	}
}
public class ToStringCollege 
{
	public static void main(String[] args) 
	{
	College c=new College(23,45,"Tanay","MCA",1023);	
	System.out.println(c);
	}
	
}
