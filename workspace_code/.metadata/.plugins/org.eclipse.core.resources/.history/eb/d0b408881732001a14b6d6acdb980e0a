package objectclassmethod;

public class CollegeTest
{
	int id;
	String name;
	CollegeTest(int id,String name)
	{
		this.id=id;
		this.name=name;

	}
	public String toString()
	{
		return id+" "+name;	
	}
	public int hashCode()
	{
		String s=id+" "+ name;
		int h=s.hashCode();
		return h;
	}
	public boolean equals(Object o)
	{
		CollegeTest c= (CollegeTest)o;
		if(this.hashCode()==c.hashCode())
		{
			return true;
		}
		else
		{
			return false;

		}
	}

	public static void main(String[] args) 
	{
		CollegeTest c=new CollegeTest(12,"tamny");
		CollegeTest c1=new CollegeTest(12,"tany");
		System.out.println(c);
		int k=c.hashCode();
		int l=c1.hashCode();
		System.out.println(k);
		System.out.println(l);

		boolean b=c.equals(c1);
		System.out.println(b);
	}
}
